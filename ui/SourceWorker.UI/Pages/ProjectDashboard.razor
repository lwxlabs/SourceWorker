@inject ISourceWorkerApiClient Api

<div class="grid two">
        <Cards Title="Open Handoff">
            <p>The handoff is the main thing to give Codex, Junie, ChatGPT, Cursor, or another agent.</p>
            <div class="d-flex gap-2">
                <a class="btn btn-primary" href="/projects/@ProjectId/handoff">Open Handoff</a>
                <a class="btn" href="/projects/@ProjectId/ai">Ask with context</a>
            </div>
        </Cards>

        <Cards Title="Next Action">
            @if (nextActions.Count == 0)
            {
                <p>No recommended action available.</p>
            }
            else
            {
                var action = nextActions.First();
                <h3>@action.Title</h3>
                <p>@action.Description</p>
                @if (!string.IsNullOrWhiteSpace(action.Href))
                {
                    <a class="btn" href="@action.Href">Open</a>
                }
            }
        </Cards>
</div>

<div class="grid two">
        <Cards Title="Scan Status">
            <div class="metric-grid">
                <MetricCard Label="Completeness" Value="@($"{completeness?.Score ?? 0}%")" />
                <MetricCard Label="Warnings" Value="@((completeness?.Warnings.Count ?? 0).ToString())" />
                <MetricCard Label="Packs" Value="@packs.Count.ToString()" />
                <MetricCard Label="Artifact Health" Value="@ArtifactHealth" />
            </div>
            <p class="muted">@completeness?.CodeIntelligenceExplanation</p>
            <a href="/projects/@ProjectId/scan-health">Open scan health</a>
        </Cards>

        <Cards Title="Quick Ask">
            <p>SourceWorker prepares context. It does not edit files or apply AI output.</p>
            <textarea rows="3" @bind="quickAsk" placeholder="Ask about this project..."></textarea>
            <div class="d-flex gap-2">
                <button class="btn" @onclick="PreviewQuickAsk">Preview</button>
                <button class="btn btn-primary" @onclick="RunQuickAsk" disabled="@(quickPreview is null)">Ask</button>
            </div>
            @if (quickPreview is not null)
            {
                <div class="list-row"><strong>Tokens</strong><span>@quickPreview.Preview.TokenEstimate.TotalTokens</span></div>
                <MarkDown Preview="true" SplitView="false" Value="@(quickPreview.Run?.OutputText ?? quickPreview.Preview.PromptText)" EnableMenu="true" ShowToolBarButtons="false" ShowThemeSelector="false" AllowFullScreen="true" />

            }
        </Cards>
</div>

@if (completeness?.Warnings.Count > 0)
{
    <Cards Title="Needs Attention">
        @foreach (var warning in completeness.Warnings.Take(6))
        {
            <div class="list-row"><strong>@warning.Code</strong><span>@warning.Message</span></div>
        }
    </Cards>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<ContextPackManifest> packs = [];
    private IReadOnlyList<NextActionDto> nextActions = [];
    private ScanCompletenessReportDto? completeness;
    private ArtifactLifecycleReport? artifacts;
    private string quickAsk = "";
    private QuickAskResultDto? quickPreview;

    private string ArtifactHealth => artifacts is null ? "Unknown" : AttentionCount == 0 ? "Healthy" : "Needs review";
    private int AttentionCount => (artifacts?.ManuallyModifiedArtifacts.Count ?? 0) + (artifacts?.MissingArtifacts.Count ?? 0) + (artifacts?.StaleArtifacts.Count ?? 0) + (artifacts?.DeprecatedArtifacts.Count ?? 0) + (artifacts?.OrphanedArtifacts.Count ?? 0);

    protected override async Task OnParametersSetAsync()
    {
        packs = await Api.GetPacksAsync(ProjectId);
        nextActions = await Api.GetProjectNextActionsAsync(ProjectId);
        completeness = await Api.GetScanCompletenessAsync(ProjectId);
        artifacts = await Api.GetArtifactsAsync(ProjectId);
    }

    private async Task PreviewQuickAsk()
        => quickPreview = await Api.PreviewQuickAskAsync(ProjectId, new QuickAskRequestDto(ProjectId, quickAsk, null, null, null, null, false));

    private async Task RunQuickAsk()
        => quickPreview = await Api.RunQuickAskAsync(ProjectId, new QuickAskRequestDto(ProjectId, quickAsk, null, null, null, null, true));
}
