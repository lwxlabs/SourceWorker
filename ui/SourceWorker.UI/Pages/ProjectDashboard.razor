@page "/projects/{ProjectId:guid}"
@inject ISourceWorkerApiClient Api

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
    <h1>@(project?.Name ?? "Project")</h1>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <span style="font-size: 0.8rem; color: #666;">Last loaded: @lastLoaded.ToString("T")</span>
        <button @onclick="Refresh" style="padding: 4px 12px; border: 1px solid #ccc; border-radius: 4px; background: #f8f9fa; cursor: pointer; font-size: 0.9rem;">Refresh</button>
    </div>
</div>

@if (project is not null)
{
    <p class="path" style="margin-bottom: 1rem; color: #666;">@project.RootPath</p>
    
    <div class="mb-4">
        <ScanProjectButton ProjectId="@ProjectId" OnScanCompleted="Refresh" />
    </div>

    <nav class="tabs">
        <a href="/projects/@ProjectId/context">Context</a>
        <a href="/projects/@ProjectId/docs">Docs</a>
        <a href="/projects/@ProjectId/packs">Packs</a>
        <a href="/projects/@ProjectId/code">Code</a>
        <a href="/projects/@ProjectId/artifacts">Artifacts</a>
        <a href="/projects/@ProjectId/ai">AI Preview</a>
        <a href="/projects/@ProjectId/onboarding">Onboarding</a>
    </nav>

    <div style="display:flex; gap:0.5rem; margin: 1rem 0;">
        <a href="/projects/@ProjectId/ai">Start AI preview</a>
        <a href="/projects/@ProjectId/docs">Open backend docs</a>
        <a href="/projects/@ProjectId/packs">Open packs</a>
    </div>
}

<div class="grid two">
    <ContextFreshnessCard Status="@freshness" />
    <DoctorSummaryCard Report="@doctor" />
    <ArtifactStatusCard Report="@artifacts" />
    <OutputRoutesCard Outputs="@outputs" />
    <ContextPacksCard Packs="@packs" />
    <CodeIntelligenceSummaryCard Symbols="@symbols" Routes="@routes" Flows="@flows" Tests="@tests" />
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private ProjectDto? project;
    private DoctorReport? doctor;
    private ContextFreshnessReport? freshness;
    private ArtifactLifecycleReport? artifacts;
    private GeneratedOutputSet? outputs;
    private IReadOnlyList<ContextPackManifest> packs = [];
    private IReadOnlyList<CodeSymbol> symbols = [];
    private IReadOnlyList<RouteInfo> routes = [];
    private IReadOnlyList<CodeFlow> flows = [];
    private IReadOnlyList<TestInfo> tests = [];
    
    private DateTimeOffset lastLoaded = DateTimeOffset.Now;

    protected override async Task OnParametersSetAsync()
    {
        await Refresh();
    }

    private async Task Refresh()
    {
        try 
        {
            project = (await Api.GetProjectsAsync()).FirstOrDefault(p => p.Id == ProjectId);
            doctor = await Api.GetDoctorAsync(ProjectId);
            freshness = await Api.GetContextStatusAsync(ProjectId);
            artifacts = await Api.GetArtifactsAsync(ProjectId);
            outputs = await Api.GetOutputsAsync(ProjectId);
            packs = await Api.GetPacksAsync(ProjectId);
            symbols = await Api.GetSymbolsAsync(ProjectId);
            routes = await Api.GetRoutesAsync(ProjectId);
            flows = await Api.GetFlowsAsync(ProjectId);
            tests = await Api.GetTestsAsync(ProjectId);
            lastLoaded = DateTimeOffset.Now;
        }
        catch (Exception)
        {
            // Error handling could be improved
        }
    }
}
