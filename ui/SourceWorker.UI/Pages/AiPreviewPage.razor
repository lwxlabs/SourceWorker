@inject ISourceWorkerApiClient Api

<h1>Ask With Context</h1>
<p>SourceWorker does not code by itself. It prepares context, lets you ask questions, and shows a preview-only answer that you copy into your agent or notes manually.</p>

<Cards Title="Prompt Builder">
    <div class="grid two">
        <label>Provider
            <select @bind="providerId">
                @foreach (var provider in providers)
                {
                    <option value="@provider.ProviderId">@ProviderDisplay(provider)</option>
                }
            </select>
        </label>
        <label>Context pack
            <select @bind="packId">
                @foreach (var pack in packs)
                {
                    <option value="@pack.Pack.Id">@pack.Pack.Name</option>
                }
            </select>
        </label>
        <label>Prompt template
            <select @bind="templateId">
                <option value="general-project-question">General project question</option>
                <option value="continue-development">Continue development</option>
                <option value="explain-architecture">Explain architecture</option>
                <option value="find-risks">Find risks</option>
                <option value="improve-docs">Improve docs</option>
                <option value="create-next-steps">Create next steps</option>
                <option value="review-branch">Review branch</option>
                <option value="bug-investigation">Bug investigation</option>
                <option value="test-planning">Test planning</option>
            </select>
        </label>
        <label>Max output tokens
            <input type="number" @bind="maxOutputTokens" />
        </label>
    </div>
    <label>User instruction
        <textarea rows="5" @bind="instruction"></textarea>
    </label>
    <button @onclick="PreviewAsync">Preview Prompt</button>
    <button @onclick="RunAsync" disabled="@(preview is null)">Ask AI</button>
</Cards>

<Cards Title="AI Safety">
    <p>AI output is preview-only. SourceWorker does not apply patches, run terminals, or write files from AI responses. Copy the answer manually if it is useful.</p>
    @if (usage is not null)
    {
        <div class="list-row"><strong>Project runs</strong><span>@usage.TotalRuns total, @usage.SuccessfulRuns successful, @usage.FailedRuns failed</span></div>
    }
    @if (quality is not null)
    {
        <div class="list-row"><strong>Pack readiness</strong><span>@quality.ReadinessScore% @(quality.IsRecommended ? "recommended" : "needs review")</span></div>
    }
</Cards>

@if (preview is not null)
{
    <Cards Title="Prompt Preview">
        <div class="grid two">
            <MetricCard Label="Prompt tokens" Value="@preview.TokenEstimate.PromptTokens.ToString()" />
            <MetricCard Label="Total estimate" Value="@preview.TokenEstimate.TotalTokens.ToString()" />
            <MetricCard Label="Context usage" Value="@($"{preview.ContextWindowUsagePercent}%")" />
            <MetricCard Label="Cost" Value="@(preview.CostEstimate.TotalCostUsd?.ToString("C") ?? "unknown")" />
        </div>
        <div class="list-row"><strong>Prompt hash</strong><span>@preview.PromptHash</span></div>
        @if (preview.IsTooLarge)
        {
            <p>Prompt is too large for the selected model context window.</p>
        }
        <h3>Included files</h3>
        @foreach (var file in preview.IncludedFileDetails ?? [])
        {
            <div class="list-row"><strong>@(file.Exists ? "Included" : "Missing")</strong><span>@file.RelativePath - @file.TokenEstimate tokens</span></div>
        }
        @if (preview.SafetyWarnings.Count > 0)
        {
            <h3>Safety warnings</h3>
            @foreach (var warning in preview.SafetyWarnings)
            {
                <div class="list-row"><strong>@warning.Severity</strong><span>@warning.Message</span></div>
            }
        }
        <h3>Prompt sections</h3>
        @foreach (var section in preview.Sections ?? [])
        {
            <div class="list-row"><strong>@section.Title</strong><span>@section.TokenEstimate tokens</span></div>
        }
        <pre style="white-space: pre-wrap;">@preview.PromptText</pre>
    </Cards>
}

@if (run is not null)
{
    <Cards Title="AI Output">
        <div class="list-row"><strong>Status</strong><span>@run.Status</span></div>
        @if (!string.IsNullOrWhiteSpace(run.Error))
        {
            <p>@run.Error</p>
        }
        <pre style="white-space: pre-wrap;">@run.OutputText</pre>
    </Cards>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private IReadOnlyList<AiProviderStatusDto> providers = [];
    private IReadOnlyList<ContextPackManifest> packs = [];
    private string providerId = "";
    private string packId = "";
    private string templateId = "general-project-question";
    private int maxOutputTokens = 1200;
    private string? instruction;
    private AiPromptPreviewResponse? preview;
    private AiRunDetailDto? run;
    private AiUsageSummaryDto? usage;
    private AiContextPackQualityReportDto? quality;

    protected override async Task OnInitializedAsync()
    {
        providers = await Api.GetAiProvidersAsync();
        packs = await Api.GetAiPacksAsync(ProjectId);
        providerId = providers.FirstOrDefault()?.ProviderId ?? "Ollama";
        packId = packs.FirstOrDefault()?.Pack.Id ?? "backend-docs";
        usage = await Api.GetProjectAiUsageAsync(ProjectId);
        if (!string.IsNullOrWhiteSpace(packId)) quality = await Api.GetAiPackQualityAsync(ProjectId, packId);
    }

    private async Task PreviewAsync()
    {
        quality = await Api.GetAiPackQualityAsync(ProjectId, packId);
        preview = await Api.PreviewAiPromptAsync(ProjectId, new AiPromptPreviewRequest(providerId, packId, instruction, maxOutputTokens, templateId));
    }

    private async Task RunAsync()
    {
        run = await Api.StartAiRunAsync(ProjectId, new AiRunRequest(providerId, packId, instruction, preview?.SafetyWarnings.Count > 0, maxOutputTokens));
        usage = await Api.GetProjectAiUsageAsync(ProjectId);
    }

    private static string ProviderDisplay(AiProviderStatusDto provider)
    {
        var name = string.IsNullOrWhiteSpace(provider.Name) ? provider.Kind.ToString() : provider.Name;
        var baseUrl = string.IsNullOrWhiteSpace(provider.BaseUrl) ? "" : $" ({provider.BaseUrl})";
        return $"{name} - {provider.Kind}{baseUrl}";
    }
}
