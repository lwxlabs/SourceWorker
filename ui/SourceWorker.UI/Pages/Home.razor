@page "/"
@inject ISourceWorkerApiClient Api

<h1>SourceWorker</h1>
<p class="lead">Pick a repo, scan it, understand it, and copy a clean handoff for another AI coding agent.</p>

<div class="grid two">
    <Cards Title="Start">
        <p>Register a project or continue from a recent repository.</p>
        <a class="btn btn-primary" href="/projects">Open Projects</a>
    </Cards>
    <Cards Title="Status">
        <div class="metric-grid">
            <MetricCard Label="Projects" Value="@projects.Count.ToString()" />
            <MetricCard Label="Handoff Ready" Value="@HandoffReadyCount.ToString()" />
            <MetricCard Label="Needs Scan" Value="@NeedsScanCount.ToString()" />
            <MetricCard Label="Needs Review" Value="@NeedsReviewCount.ToString()" />
        </div>
    </Cards>
</div>

<Cards Title="Recent Projects">
    <ProjectPicker Projects="@projects" />
</Cards>

@code {
    private IReadOnlyList<ProjectSummaryDto> projects = [];

    private int HandoffReadyCount => projects.Count(p => p.LastScanUtc.HasValue && !p.HasStaleContext);
    private int NeedsScanCount => projects.Count(p => !p.LastScanUtc.HasValue);
    private int NeedsReviewCount => projects.Count(p => p.HasStaleContext || p.HasManualGeneratedFiles);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            projects = await Api.GetProjectsSummaryAsync(limit: 6);
        }
        catch
        {
            projects = [];
        }
    }
}
