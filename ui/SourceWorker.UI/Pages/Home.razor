@page "/"
@inject ISourceWorkerApiClient Api

<h1>SourceWorker Dashboard</h1>
<p class="lead">Read-only cockpit for the local context engine.</p>

<div class="grid two">
    <HealthCard Health="@health" />
    <StorageInfoCard Info="@storage" />
</div>

<Cards Title="Next Recommended Action">
    @if (dogfood is null)
    {
        <LoadingState />
    }
    else
    {
        <div class="list-row"><strong>Dogfood readiness</strong><span>@dogfood.Score% - @dogfood.Checklist.Status</span></div>
        @foreach (var action in dogfood.Checklist.NextActions)
        {
            <div class="list-row"><strong>Next</strong><span>@action</span></div>
        }
        @foreach (var action in nextActions)
        {
            <div class="list-row"><strong>@action.Priority</strong><span><a href="@action.Href">@action.Title</a> - @action.Description</span></div>
        }
        <a href="/dogfood">Open dogfood checklist</a>
    }
</Cards>

<Cards Title="Projects">
    <ProjectPicker Projects="@projects" />
</Cards>

@code {
    private HealthResponse? health;
    private StorageInfo? storage;
    private DogfoodProjectReadinessDto? dogfood;
    private IReadOnlyList<NextActionDto> nextActions = [];
    private IReadOnlyList<ProjectSummaryDto> projects = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            health = await Api.GetHealthAsync();
            storage = await Api.GetStorageInfoAsync();
            projects = await Api.GetProjectsSummaryAsync(limit: 5);
            dogfood = await Api.GetDogfoodStatusAsync();
            nextActions = await Api.GetNextActionsAsync();
        }
        catch
        {
            projects = [];
        }
    }
}
