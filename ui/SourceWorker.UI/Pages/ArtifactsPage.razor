@page "/projects/{ProjectId:guid}/artifacts"
@inject ISourceWorkerApiClient Api
@inject ToastService Toast
@inject DashboardActionService Actions

<ProjectWorkspaceLayout ProjectId="@ProjectId" Active="artifacts">
    <h1>Generated Files Health</h1>
    <p class="text-muted">Generated artifacts are tracked so SourceWorker can detect stale, missing, manually edited, orphaned, or deprecated files. Healthy generated files are collapsed by default.</p>

    <div class="mb-4 d-flex align-items-center gap-2">
        @{ var previewAvail = Actions.GetAvailability(DashboardActionKind.CleanupPreview); }
        <button class="btn btn-outline-primary" @onclick="LoadPreview" disabled="@(!previewAvail.IsEnabled || loadingPreview)" title="@previewAvail.DisabledReason">
            @if (loadingPreview)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            Cleanup Preview
        </button>
        @if (preview != null && preview.Candidates.Any(c => c.SafeToDelete))
        {
            var cleanupAvail = Actions.GetAvailability(DashboardActionKind.CleanupGenerated);
            <button class="btn btn-danger" @onclick="() => showConfirmCleanup = true" disabled="@(!cleanupAvail.IsEnabled)" title="@cleanupAvail.DisabledReason">Cleanup Generated</button>
        }
    </div>

    @if (report is not null)
    {
        <Cards Title="Summary">
            <div class="metric-grid">
                <MetricCard Label="Needs Review" Value="@IssueCount.ToString()" />
                <MetricCard Label="Healthy" Value="@HealthyCount.ToString()" />
                <MetricCard Label="Manual Edits" Value="@report.ManuallyModifiedArtifacts.Count.ToString()" />
                <MetricCard Label="Cleanup Available" Value="@(report.CleanupRecommended ? "Yes" : "No")" />
            </div>
            <p>@(IssueCount == 0 ? $"{HealthyCount} generated files look healthy." : $"{IssueCount} need review, {HealthyCount} healthy/generated.")</p>
        </Cards>

        <Cards Title="Needs Attention">
            @foreach (var path in IssuePaths)
            {
                <div class="list-row"><strong>@IssueStatus(path)</strong><code>@path</code></div>
            }
            @if (!IssuePaths.Any())
            {
                <EmptyState Message="No generated file issues found." />
            }
        </Cards>

        <details class="mt-3">
            <summary>Safe generated files (@HealthyCount)</summary>
            @foreach (var artifact in report.Artifacts.Where(a => a.Status == "Generated").OrderBy(a => a.RelativePath).Take(300))
            {
                <div class="list-row compact"><strong>@artifact.Type</strong><code>@artifact.RelativePath</code></div>
            }
        </details>

        <details class="mt-3">
            <summary>Technical artifact records</summary>
            @foreach (var artifact in report.Artifacts.OrderBy(a => a.RelativePath))
            {
                <div class="list-row compact">
                    <strong>@artifact.Status</strong>
                    <span>@artifact.Type</span>
                    <code>@artifact.RelativePath</code>
                </div>
            }
        </details>
    }

    @if (preview != null)
    {
        <div class="mt-3">
            <CleanupPreviewPanel Preview="@preview" />
        </div>
    }
</ProjectWorkspaceLayout>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private ArtifactLifecycleReport? report;
    private CleanupPreviewDto? preview;
    private bool loadingPreview;
    private bool showConfirmCleanup;

    private IEnumerable<string> IssuePaths => (report?.ManuallyModifiedArtifacts ?? [])
        .Concat(report?.MissingArtifacts ?? [])
        .Concat(report?.StaleArtifacts ?? [])
        .Concat(report?.DeprecatedArtifacts ?? [])
        .Concat(report?.OrphanedArtifacts ?? [])
        .Distinct(StringComparer.OrdinalIgnoreCase);

    private int IssueCount => IssuePaths.Count();
    private int HealthyCount => Math.Max(0, (report?.Artifacts.Count ?? 0) - IssueCount);

    protected override async Task OnParametersSetAsync()
    {
        await LoadArtifacts();
    }

    private async Task LoadArtifacts()
    {
        report = await Api.GetArtifactsAsync(ProjectId);
    }

    private string IssueStatus(string path)
    {
        if (report?.ManuallyModifiedArtifacts.Contains(path) == true) return "Manually modified";
        if (report?.MissingArtifacts.Contains(path) == true) return "Missing";
        if (report?.StaleArtifacts.Contains(path) == true) return "Stale";
        if (report?.DeprecatedArtifacts.Contains(path) == true) return "Deprecated";
        if (report?.OrphanedArtifacts.Contains(path) == true) return "Orphaned";
        return "Needs review";
    }

    private async Task LoadPreview()
    {
        loadingPreview = true;
        try
        {
            preview = await Api.GetCleanupPreviewAsync(ProjectId);
            Toast.ShowInfo("Cleanup preview loaded.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load cleanup preview: {ex.Message}");
        }
        finally
        {
            loadingPreview = false;
        }
    }

    private async Task RunCleanup()
    {
        try
        {
            var result = await Api.CleanupGeneratedAsync(ProjectId, dryRun: false, force: false);
            Toast.ShowSuccess($"Cleanup completed. Deleted {result.DeletedFiles.Count} files.");
            preview = null;
            await LoadArtifacts();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to run cleanup: {ex.Message}");
        }
    }
}

<ConfirmActionDialog
    @bind-IsVisible="showConfirmCleanup"
    Title="Confirm Cleanup"
    ConfirmText="Run Cleanup"
    ConfirmButtonClass="btn-danger"
    OnConfirm="RunCleanup">
    <DangerousActionWarning Message="@($"This will delete {preview?.SafeToDeleteCount} files identified as safe to remove. Manually modified files and missing records will not be deleted.")" />
</ConfirmActionDialog>
