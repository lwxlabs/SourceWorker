@using LwXLab.FileEditor.Components
@using LwXLab.FileEditor.Models
@using LwXLab.FileEditor.Options
@using LwXLab.AI.Engine.Agents
@using LwXLab.AI.Engine.Models
@using LwXLab.AI.Engine.Providers
@using System.Diagnostics
@using System.Text
@inject ProjectFileEditorContext FileEditorContext
@inject ILwAiAgentEngine AiEngine
@inject ILwAiProviderRegistry AiProviderRegistry
@inject ISourceWorkerApiClient Api

<FileEditor Title="Project Files"
            Theme="LwFileEditorTheme.Dark"
            ViewMode="LwFileEditorViewMode.Split"
            Options="options"
            AiEngine="AiEngine"
            AiProviderRegistry="AiProviderRegistry"
            DefaultAiProviderId="lm-studio-local"
            DefaultAiModel="gs/qwen3.5-9b"
            EnableAiTerminal="true"
            AiTerminalProvider="RunAiTerminalAsync"
            OnFormatDocument="FormatDocumentAsync"
            OnValidateDocument="ValidateDocumentAsync" />

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private readonly LwFileEditorOptions options = new()
    {
        EnableMenuBar = true,
        EnableActivityBar = true,
        EnableCommandPalette = true,
        EnableFind = true,
        EnableReplace = true,
        EnableWorkspaceSearch = true,
        EnableProblemsPanel = true,
        EnableEditorSplitting = true,
        EnableDraggableSplitPanes = true,
        EnableLocalDraftBackup = true,
        EnableUnsavedChangesGuard = true,
        EnableSourceControlPanel = false,
        EnableTerminalPanel = false,
        EnableAiActions = true,
        EnableAiPanel = true,
        EnableAiContextMenus = true,
        EnableAiApply = true,
        EnableAiContextFolderKnowledge = true,
        AiRestrictTerminalToProjectRoot = true,
        AiShowCommandGuidanceInApproval = true,
        AiAllowUnknownTerminalCommandsWithApproval = false,
        AiAllowShellOperatorsWithApproval = false,
        AiMaxTerminalContinuations = 3,
        AiRequestTimeoutMs = 180_000,
        AiTerminalTimeoutMs = 120_000,
        AiMaxOutputTokens = 4000,
        AiMaxPromptCharacters = 180_000,
        AiMaxTerminalSnapshotFiles = 300,
        AiMaxContextFiles = 12,
        IgnoredPatterns = ["bin", "obj", "node_modules", ".git", ".vs", ".idea", "dist", "build", "coverage", "*.user", "*.suo", "*.dll", "*.exe"],
        AutoSaveMode = LwAutoSaveMode.Off,
        Height = "calc(100vh - 190px)",
        SidebarWidth = "300px",
        LayoutStorageKey = "sourceworker-project-file-editor"
    };
    private string? projectRoot;

    protected override async Task OnParametersSetAsync()
    {
        FileEditorContext.SetProject(ProjectId);
        options.LayoutStorageKey = $"sourceworker-project-file-editor-{ProjectId:N}";
        projectRoot = (await Api.GetProjectsAsync()).FirstOrDefault(project => project.Id == ProjectId)?.RootPath;
    }

    private static Task<string> FormatDocumentAsync(LwFileEditorTab tab)
        => Task.FromResult(tab.Content);

    private static Task<IReadOnlyList<LwDiagnostic>> ValidateDocumentAsync(LwFileEditorTab tab)
        => Task.FromResult<IReadOnlyList<LwDiagnostic>>([]);

    private async Task<LwAiTerminalActionResult> RunAiTerminalAsync(LwAiTerminalActionRequest request, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(request.Command))
            return new() { ExitCode = -1, Error = "No command was provided." };

        if (string.IsNullOrWhiteSpace(projectRoot))
            projectRoot = (await Api.GetProjectsAsync(cancellationToken)).FirstOrDefault(project => project.Id == ProjectId)?.RootPath;

        if (string.IsNullOrWhiteSpace(projectRoot))
            return new() { Command = request.Command, ExitCode = -1, Error = "Blocked: selected project root could not be resolved." };

        if (request.Access == LwAiTerminalAccess.ReadOnly && !LooksReadOnlyCommand(request.Command))
        {
            return new()
            {
                Command = request.Command,
                WorkingDirectory = request.WorkingDirectory,
                ExitCode = -1,
                Error = "Blocked: Ask mode only allows read-only terminal commands."
            };
        }

        var workingDirectory = ResolveTerminalWorkingDirectory(request.WorkingDirectory, projectRoot);
        if (workingDirectory is null)
        {
            return new()
            {
                Command = request.Command,
                WorkingDirectory = request.WorkingDirectory,
                ExitCode = -1,
                Error = "Blocked: terminal working directory must exist inside the selected project root."
            };
        }

        var isWindows = OperatingSystem.IsWindows();
        var shell = isWindows && CommandExists("pwsh") ? "pwsh" : isWindows ? "powershell.exe" : "/bin/bash";
        using var process = new Process();
        process.StartInfo = new ProcessStartInfo
        {
            FileName = shell,
            Arguments = isWindows
                ? "-NoProfile -NonInteractive -EncodedCommand " + EncodePowerShellCommand(request.Command)
                : "-lc " + QuoteShellCommand(request.Command),
            WorkingDirectory = workingDirectory,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false,
            CreateNoWindow = true
        };

        var output = new StringBuilder();
        var error = new StringBuilder();
        process.OutputDataReceived += (_, e) => { if (e.Data is not null) output.AppendLine(e.Data); };
        process.ErrorDataReceived += (_, e) => { if (e.Data is not null) error.AppendLine(e.Data); };

        try
        {
            using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
            timeoutCts.CancelAfter(Math.Clamp(request.TimeoutMilliseconds <= 0 ? 120_000 : request.TimeoutMilliseconds, 5_000, 120_000));
            process.Start();
            process.BeginOutputReadLine();
            process.BeginErrorReadLine();
            await process.WaitForExitAsync(timeoutCts.Token);
        }
        catch (OperationCanceledException)
        {
            try
            {
                if (!process.HasExited)
                    process.Kill(entireProcessTree: true);
            }
            catch
            {
            }

            return new()
            {
                Command = request.Command,
                WorkingDirectory = process.StartInfo.WorkingDirectory,
                ExitCode = -1,
                Output = output.ToString(),
                Error = error.ToString(),
                Canceled = true
            };
        }
        catch (Exception ex)
        {
            return new()
            {
                Command = request.Command,
                WorkingDirectory = process.StartInfo.WorkingDirectory,
                ExitCode = -1,
                Error = ex.Message
            };
        }

        return new()
        {
            Command = request.Command,
            WorkingDirectory = process.StartInfo.WorkingDirectory,
            ExitCode = process.ExitCode,
            Output = Truncate(output.ToString(), GetMaxOutputCharacters(request), out var outTruncated),
            Error = Truncate(error.ToString(), GetMaxOutputCharacters(request) / 2, out var errTruncated),
            Truncated = outTruncated || errTruncated
        };
    }

    private static bool LooksReadOnlyCommand(string command)
    {
        var normalized = " " + command.Trim().ToLowerInvariant() + " ";
        var allowedPrefixes = new[]
        {
            "dir", "ls", "get-childitem", "gc ", "cat ", "type ", "get-content", "rg ", "findstr ",
            "git status", "git diff", "git log", "git show", "dotnet --info",
            "node --version", "python --version", "where ", "which "
        };

        var blockedTokens = new[]
        {
            " rm ", " del ", " remove-item", " rmdir", " rd ", "erase ", "move-item", " mv ",
            "copy-item", " cp ", "set-content", "out-file", "new-item", "mkdir", "git reset",
            "git checkout", "git clean", "git commit", "git push", "npm install"
        };

        return allowedPrefixes.Any(prefix => normalized.Contains(" " + prefix.Trim().ToLowerInvariant(), StringComparison.OrdinalIgnoreCase)) &&
               !blockedTokens.Any(token => normalized.Contains(token, StringComparison.OrdinalIgnoreCase));
    }

    private static string EncodePowerShellCommand(string command) => Convert.ToBase64String(Encoding.Unicode.GetBytes(command));
    private static string QuoteShellCommand(string command) => "'" + command.Replace("'", "'\\''") + "'";

    private static string? ResolveTerminalWorkingDirectory(string? workingDirectory, string projectRoot)
    {
        var root = Path.GetFullPath(projectRoot);

        var candidate = string.IsNullOrWhiteSpace(workingDirectory)
            ? root
            : Path.IsPathFullyQualified(workingDirectory)
                ? Path.GetFullPath(workingDirectory)
                : Path.GetFullPath(Path.Combine(root, workingDirectory));

        if (!Directory.Exists(candidate))
            return null;

        var comparison = OperatingSystem.IsWindows()
            ? StringComparison.OrdinalIgnoreCase
            : StringComparison.Ordinal;

        return candidate.StartsWith(root, comparison) ? candidate : null;
    }

    private static int GetMaxOutputCharacters(LwAiTerminalActionRequest request) =>
        Math.Clamp(request.MaxOutputCharacters <= 0 ? 20_000 : request.MaxOutputCharacters, 1_000, 80_000);

    private static string Truncate(string value, int maxCharacters, out bool truncated)
    {
        if (string.IsNullOrEmpty(value))
        {
            truncated = false;
            return string.Empty;
        }

        if (value.Length <= maxCharacters)
        {
            truncated = false;
            return value;
        }

        truncated = true;
        return value[..maxCharacters] + "\n\n[Output truncated]";
    }

    private static bool CommandExists(string command)
    {
        try
        {
            var probe = new ProcessStartInfo
            {
                FileName = "where",
                Arguments = command,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };
            using var process = Process.Start(probe);
            process?.WaitForExit(1000);
            return process?.ExitCode == 0;
        }
        catch
        {
            return false;
        }
    }
}
