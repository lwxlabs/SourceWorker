<DynamicComponent Type="EditorType" Parameters="EditorParameters" />

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private Type EditorType =>
#if SOURCEWORKER_PRIVATE_EXTENSIONS
        typeof(AdvancedFilesPage);
#else
        typeof(PublicFilesPage);
#endif
    private IDictionary<string, object> EditorParameters => new Dictionary<string, object> { ["ProjectId"] = ProjectId };
}
