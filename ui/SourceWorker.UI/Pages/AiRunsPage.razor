@page "/projects/{ProjectId:guid}/ai/runs"
@inject ISourceWorkerApiClient Api

<ProjectWorkspaceLayout ProjectId="@ProjectId" Active="ai">
<h1>AI Runs</h1>

<Cards Title="Filters">
    <label>Status
        <select @bind="statusFilter">
            <option value="">All</option>
            <option value="Completed">Successful only</option>
            <option value="Failed">Failed only</option>
        </select>
    </label>
    <button @onclick="RefreshAsync">Refresh</button>
</Cards>

@if (runs is null)
{
    <LoadingState />
}
else if (runs.Count == 0)
{
    <EmptyState Message="Run an AI preview from a context pack to see history here." />
}
else
{
    <Cards Title="Run History">
        @foreach (var item in FilteredRuns)
        {
            <div class="list-row">
                <strong>@item.ProviderKind / @item.Model</strong>
                <span>@item.PackId - @item.Status - @item.CreatedUtc.ToString("g") - @Duration(item)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(item.Error))
            {
                <p>@item.Error</p>
            }
            @if (!string.IsNullOrWhiteSpace(item.OutputText))
            {
                <pre style="white-space: pre-wrap;">@item.OutputText</pre>
            }
        }
    </Cards>
}
</ProjectWorkspaceLayout>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private IReadOnlyList<AiRunSummaryDto>? runs;
    private string statusFilter = "";
    private IEnumerable<AiRunSummaryDto> FilteredRuns => string.IsNullOrWhiteSpace(statusFilter) ? runs ?? [] : (runs ?? []).Where(r => r.Status.ToString() == statusFilter);

    protected override async Task OnInitializedAsync()
        => await RefreshAsync();
    private async Task RefreshAsync() => runs = await Api.GetAiRunsAsync(ProjectId);
    private static string Duration(AiRunSummaryDto run) => run.CompletedUtc is null ? "running" : (run.CompletedUtc.Value - run.CreatedUtc).ToString(@"hh\:mm\:ss");
}
