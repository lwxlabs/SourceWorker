@page "/projects/{ProjectId:guid}/explanation"
@inject ISourceWorkerApiClient Api
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ToastService Toast

<ProjectWorkspaceLayout ProjectId="@ProjectId" Active="explanation">
    <section class="handoff-hero">
        <div>
            <p class="eyebrow">AI Explanation</p>
            <h2>Generate a project explanation</h2>
            <p>Generate a human-readable explanation from scanned context. This does not edit source code. A successful generation is saved as a generated docs file, and you can edit and save it again afterward.</p>
            @if (!busy && !string.IsNullOrWhiteSpace(operationMessage))
            {
                <p class="callout @operationTone">@operationMessage</p>
            }
        </div>
        <div class="project-actions">
            <button class="btn" @onclick="PreviewAsync" disabled="@(!CanPreview || busy || activeJobId is not null)">Preview Prompt</button>
            <button class="btn btn-primary" @onclick="RunAsync" disabled="@(!CanPreview || busy || activeJobId is not null)">Generate Explanation</button>
            <button class="btn btn-outline-danger" @onclick="CancelRunAsync" disabled="@(activeJobId is null)">Cancel</button>
            <button class="btn" @onclick="@(() => SaveAsync())" disabled="@(result?.Status != AiRunStatus.Completed || string.IsNullOrWhiteSpace(editedMarkdown) || busy || activeJobId is not null)">Save edited explanation</button>
            <a class="btn" href="@($"/projects/{ProjectId}/markdown?file=.ai-context/docs/backend/07-ai-explanation.md")">Open in Markdown Workspace</a>
            <button class="btn" @onclick="CopyAsync" disabled="@string.IsNullOrWhiteSpace(editedMarkdown)">Copy Explanation</button>
        </div>
    </section>

    @if (loading)
    {
        <LoadingState />
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ErrorState Message="@error" />
    }
    else
    {
        <Cards Title="Provider and Profile">
            @if (activeJobId is not null)
            {
                <p class="callout info">Working on the explanation request. Local models can take a while; LM Studio Developer Logs will show token/context details while this runs.</p>
            }
            <div class="grid two">
                <label>
                    Provider
                    <select class="form-select" @bind="providerId" @bind:after="ProviderChangedAsync">
                        @foreach (var provider in options?.Providers ?? [])
                        {
                            <option value="@provider.ProviderId">@ProviderDisplay(provider)</option>
                        }
                    </select>
                </label>
                <label>
                    Model
                    @if (modelOptions.Count > 0)
                    {
                        <select class="form-select" value="@model" @onchange="ModelChangedAsync">
                            @foreach (var availableModel in modelOptions)
                            {
                                <option value="@availableModel">@availableModel</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="form-control" @bind="model" @bind:after="SaveSettingsAsync" placeholder="model name" />
                    }
                    <div class="field-actions">
                        <button type="button" class="btn btn-sm" @onclick="RefreshModelsAsync" disabled="@busy">Refresh models</button>
                        @if (!string.IsNullOrWhiteSpace(modelListWarning))
                        {
                            <span class="muted">@modelListWarning</span>
                        }
                    </div>
                </label>
                <label>
                    Explanation profile
                    <select class="form-select" @bind="profile" @bind:after="SaveSettingsAsync">
                        @foreach (var item in options?.Profiles ?? Enum.GetValues<ExplanationProfile>())
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </label>
                <label>
                    Context pack
                    <select class="form-select" @bind="packId" @bind:after="SaveSettingsAsync">
                        @foreach (var pack in options?.Packs ?? [])
                        {
                            <option value="@pack.Pack.Id">@pack.Pack.Name</option>
                        }
                    </select>
                </label>
            </div>
            <div class="checkbox-row">
                <label><input type="checkbox" @bind="includeSourceSnippets" @bind:after="SaveSettingsAsync" /> Include source snippets</label>
                <label><input type="checkbox" @bind="includeTests" @bind:after="SaveSettingsAsync" /> Include tests</label>
                <label><input type="checkbox" @bind="includeGeneratedDocs" @bind:after="SaveSettingsAsync" /> Include generated docs</label>
                <label><input type="checkbox" @bind="includePublicApi" @bind:after="SaveSettingsAsync" /> Include public API</label>
                <label><input type="checkbox" @bind="includeFlows" @bind:after="SaveSettingsAsync" /> Include flows</label>
                <label><input type="checkbox" @bind="includeArchitecture" @bind:after="SaveSettingsAsync" /> Include architecture</label>
            </div>
            <label>
                Optional instruction
                <textarea class="form-control" rows="3" @bind="instruction" @bind:after="SaveSettingsAsync" placeholder="Example: Explain this for a senior developer joining the project tomorrow."></textarea>
            </label>
            <div class="grid two">
                <label>
                    Max input tokens
                    <input class="form-control" type="number" @bind="maxInputTokens" @bind:after="SaveSettingsAsync" />
                </label>
                <label>
                    Max output tokens
                    <input class="form-control" type="number" @bind="maxOutputTokens" @bind:after="SaveSettingsAsync" />
                </label>
            </div>
        </Cards>

        @if (preview is not null)
        {
            <Cards Title="Prompt Preview">
                <div class="metric-grid">
                    <MetricCard Label="Prompt tokens" Value="@preview.TokenEstimate.PromptTokens.ToString()" />
                    <MetricCard Label="Output tokens" Value="@preview.TokenEstimate.MaxOutputTokens.ToString()" />
                    <MetricCard Label="Total tokens" Value="@preview.TokenEstimate.TotalTokens.ToString()" />
                    <MetricCard Label="Prompt hash" Value="@preview.PromptHash[..Math.Min(10, preview.PromptHash.Length)]" />
                </div>
                @if (preview.ProviderKind != AiProviderKind.Ollama)
                {
                    <p class="callout warn">This provider is online or external. Selected project context will be sent to the configured AI provider.</p>
                }
                @foreach (var warning in preview.SafetyWarnings)
                {
                    <div class="list-row"><strong>@warning.Severity</strong><span>@warning.Message</span></div>
                }
                <details>
                    <summary>Included files (@preview.IncludedFiles.Count(f => f.Included))</summary>
                    @foreach (var file in preview.IncludedFiles)
                    {
                        <div class="list-row"><strong>@file.RelativePath</strong><span>@(file.Included ? $"{file.TokenEstimate} tokens" : file.Warning)</span></div>
                    }
                </details>
                <details>
                    <summary>Prompt text</summary>
                    <pre>@preview.PromptText</pre>
                </details>
            </Cards>
        }

        @if (activeJobId is not null)
        {
            <Cards Title="Generated Explanation">
                <AiExplanationJobPanel ProjectId="@ProjectId" JobId="@activeJobId.Value" OnFinished="HandleJobFinishedAsync" />
            </Cards>
        }
        else if (result is not null || !string.IsNullOrWhiteSpace(editedMarkdown))
        {
            <Cards Title="Generated Explanation">
                <div class="d-flex gap-2 flex-wrap">
                    <span class="pill">@(result?.Status.ToString() ?? "Receiving")</span>
                    @if (result?.Quality is not null)
                    {
                        <span class="pill @(result.Quality.Status == AiExplanationQualityStatus.Good ? "ok" : "warn")">Quality: @result.Quality.Status</span>
                    }
                    <span class="pill">Path: @(result?.SuggestedFilePath ?? ".ai-context/docs/backend/07-ai-explanation.md")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(result?.Error))
                {
                    <p class="callout bad">@result.Error</p>
                }
                @if (result?.Status == AiRunStatus.Completed && string.IsNullOrWhiteSpace(editedMarkdown))
                {
                    <p class="callout warn">The provider finished but returned no explanation text. Try a smaller context pack, reduce included files, or increase the local model context length.</p>
                }
                @if (result?.Quality?.Warnings.Count > 0)
                {
                    @foreach (var warning in result.Quality.Warnings)
                    {
                        <div class="list-row"><strong>Quality</strong><span>@warning</span></div>
                    }
                }
                <LwXLab.MarkDown @key="editorInstanceKey" @ref="explanationEditor" Value="@editedMarkdown"
                                 EnableMermaid="true" EnableHighlight="true" SplitView="false"
                                 Preview="true" ShowStatusBar="false" />
            </Cards>
        }
        @if (saveResult is not null)
        {
            <Cards Title="Save Result">
                <p>@(saveResult.Saved ? $"Saved to {saveResult.SavedFilePath}" : "Not saved")</p>
                @foreach (var warning in saveResult.Warnings)
                {
                    <div class="list-row"><strong>Warning</strong><span>@warning</span></div>
                }
                @if (!saveResult.Saved && saveResult.Warnings.Any(w => w.Contains("manually modified", StringComparison.OrdinalIgnoreCase)))
                {
                    <button class="btn btn-outline-danger" @onclick="ForceSaveAsync">Confirm overwrite generated explanation</button>
                }
            </Cards>
        }
    }
</ProjectWorkspaceLayout>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private AiExplanationOptionsDto? options;
    private AiExplanationPreviewDto? preview;
    private AiExplanationResultDto? result;
    private AiExplanationSaveResultDto? saveResult;
    private string editedMarkdown = "";
    private int editorInstanceKey;
    private LwXLab.MarkDown? explanationEditor;
    private string? providerId;
    private string model = "";
    private string packId = "backend-docs";
    private ExplanationProfile profile = ExplanationProfile.FullProjectExplanation;
    private string? instruction;
    private bool includeSourceSnippets = true;
    private bool includeTests = true;
    private bool includeGeneratedDocs = true;
    private bool includePublicApi = true;
    private bool includeFlows = true;
    private bool includeArchitecture = true;
    private int maxInputTokens = 60000;
    private int maxOutputTokens = 3000;
    private bool loading = true;
    private bool busy;
    private string? error;
    private bool settingsLoaded;
    private string? operationMessage;
    private string operationTone = "info";
    private readonly List<string> modelOptions = [];
    private string? modelListWarning;
    private Guid? activeJobId;
    private Guid? lastFinishedJobId;

    private bool CanPreview => !string.IsNullOrWhiteSpace(providerId) && !string.IsNullOrWhiteSpace(packId);
    private string SettingsKey => $"sourceworker:explanation-settings:{ProjectId}";
    private string JobKey => $"sourceworker:explanation-job:{ProjectId}";

    private static string ProviderDisplay(AiProviderStatusDto provider)
    {
        var name = string.IsNullOrWhiteSpace(provider.Name) ? provider.Kind.ToString() : provider.Name;
        var baseUrl = string.IsNullOrWhiteSpace(provider.BaseUrl) ? "" : $" ({provider.BaseUrl})";
        return $"{name} - {provider.Kind}{baseUrl}";
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            options = await Api.GetAiExplanationOptionsAsync(ProjectId);
            providerId = options.Providers.FirstOrDefault(p => p.Status != AiProviderStatus.Disabled)?.ProviderId ?? options.Providers.FirstOrDefault()?.ProviderId;
            model = options.Providers.FirstOrDefault(p => p.ProviderId == providerId)?.Kind == AiProviderKind.Ollama ? "llama3.1" : "gpt-4.1-mini";
            packId = options.Packs.Any(p => p.Pack.Id == "backend-docs") ? "backend-docs" : options.Packs.FirstOrDefault()?.Pack.Id ?? "ai-handoff";
            await LoadSettingsAsync();
            await EnsureModelForProviderAsync();
            await ResumeActiveJobAsync();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private AiExplanationRequestDto Request()
        => new(ProjectId, providerId ?? "", model, packId, profile, instruction, includeSourceSnippets, includeTests, includeGeneratedDocs, includePublicApi, includeFlows, includeArchitecture, maxInputTokens, maxOutputTokens, false, true);

    private async Task PreviewAsync()
    {
        busy = true;
        operationTone = "info";
        operationMessage = "Building explanation prompt preview...";
        await InvokeAsync(StateHasChanged);
        try
        {
            await SaveSettingsAsync();
            preview = await Api.PreviewAiExplanationAsync(ProjectId, Request());
            operationMessage = $"Prompt preview ready: {preview.TokenEstimate.PromptTokens} input tokens, {preview.TokenEstimate.MaxOutputTokens} output tokens.";
            operationTone = preview.IsBlocked ? "bad" : preview.SafetyWarnings.Count > 0 ? "warn" : "info";
            // Toast.ShowSuccess("Explanation prompt previewed.");
        }
        catch (Exception ex)
        {
            operationTone = "bad";
            operationMessage = ex.Message;
            Toast.ShowError(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunAsync()
    {
        if (busy) return;
        await SaveSettingsAsync();

        var request = Request();
        busy = true;
        operationTone = "info";
        operationMessage = "Starting explanation generation in the Local API...";
        result = null;
        // Clear only when the user explicitly starts a new generation. The finished job
        // must repopulate this from either the saved result or the live backend preview.
        editedMarkdown = "";
        editorInstanceKey++;
        saveResult = null;
        lastFinishedJobId = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var status = await Api.StartAiExplanationJobAsync(ProjectId, request);
            activeJobId = status.JobId;
            await JS.InvokeAsync<object>("localStorage.setItem", [JobKey, status.JobId.ToString()]);
            busy = false;
            operationMessage = "Explanation generation is running in the Local API. You can navigate away while it continues.";
            // Toast.ShowSuccess("Explanation generation started.");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            activeJobId = null;
            busy = false;
            operationTone = "bad";
            operationMessage = ex.Message;
            Toast.ShowError(ex.Message);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelRunAsync()
    {
        if (activeJobId is null) return;
        operationTone = "warn";
        operationMessage = "Cancelling explanation generation...";
        try
        {
            var status = await Api.CancelAiExplanationJobAsync(ProjectId, activeJobId.Value);
            if (status is not null)
            {
                await HandleJobFinishedAsync(status);
            }
            // Toast.ShowSuccess("Explanation generation cancellation requested.");
        }
        catch (Exception ex)
        {
            operationTone = "bad";
            operationMessage = ex.Message;
            Toast.ShowError(ex.Message);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleJobFinishedAsync(AiExplanationJobStatusDto status)
    {
        if (lastFinishedJobId == status.JobId) return;

        lastFinishedJobId = status.JobId;
        activeJobId = null;
        busy = false;
        operationTone = status.IsFailed ? "bad" : status.IsCancelled ? "warn" : "info";
        operationMessage = status.Message;
        await JS.InvokeAsync<object>("localStorage.removeItem", [JobKey]);

        if (status.Result is not null)
        {
            result = status.Result;
            var finishedMarkdown = !string.IsNullOrWhiteSpace(status.Result.Markdown)
                ? status.Result.Markdown
                : status.MarkdownPreview;
            if (!string.IsNullOrWhiteSpace(finishedMarkdown))
            {
                editedMarkdown = finishedMarkdown;
                editorInstanceKey++;
            }

            if (!string.IsNullOrWhiteSpace(status.Result.Error))
            {
                operationTone = "bad";
                operationMessage = status.Result.Error;
            }
        }

        if (status.IsCompleted)
        {
            var hasMarkdown = !string.IsNullOrWhiteSpace(editedMarkdown);
            operationTone = hasMarkdown ? "info" : "bad";
            operationMessage = hasMarkdown
                ? $"Explanation generated and saved: {editedMarkdown.Length} markdown characters. You can review or edit it here."
                : result?.Error ?? "Explanation completed without saved markdown.";
            // Toast.ShowSuccess(hasMarkdown ? "Explanation generated and saved." : "Explanation finished without markdown.");
        }
        else if (status.IsFailed || status.IsCancelled)
        {
            Toast.ShowError(status.IsCancelled ? "Explanation generation cancelled." : operationMessage ?? "Explanation generation failed.");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ResumeActiveJobAsync()
    {
        var value = await JS.InvokeAsync<string?>("localStorage.getItem", [JobKey]);
        if (!Guid.TryParse(value, out var jobId)) return;

        try
        {
            var status = await Api.GetAiExplanationJobAsync(ProjectId, jobId);
            if (status is null || status.IsCompleted || status.IsFailed || status.IsCancelled)
            {
                await JS.InvokeAsync<object>("localStorage.removeItem", [JobKey]);
                if (status is not null)
                {
                    await HandleJobFinishedAsync(status);
                }
                return;
            }

            activeJobId = jobId;
            busy = false;
        }
        catch
        {
            await JS.InvokeAsync<object>("localStorage.removeItem", [JobKey]);
        }
    }

    private async Task ProviderChangedAsync()
    {
        await EnsureModelForProviderAsync(force: true);
        await SaveSettingsAsync();
    }

    private async Task ModelChangedAsync(ChangeEventArgs args)
    {
        model = args.Value?.ToString() ?? "";
        await SaveSettingsAsync();
    }

    private async Task RefreshModelsAsync()
    {
        await EnsureModelForProviderAsync(force: true);
        await SaveSettingsAsync();
    }

    private async Task EnsureModelForProviderAsync(bool force = false)
    {
        if (string.IsNullOrWhiteSpace(providerId)) return;
        var keepExisting = !force && !string.IsNullOrWhiteSpace(model) && model != "gpt-4.1-mini";

        var provider = options?.Providers.FirstOrDefault(p => p.ProviderId == providerId);
        if (provider is null) return;

        try
        {
            var models = await Api.GetAiProviderModelsAsync(providerId);
            modelOptions.Clear();
            modelOptions.AddRange(models.Models
                .Where(m => !m.Contains("embedding", StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase));
            modelListWarning = models.Warning;

            var candidates = modelOptions.ToArray();
            var selected = keepExisting
                ? candidates.FirstOrDefault(m => m.Equals(model, StringComparison.OrdinalIgnoreCase))
                : null;
            selected ??= force
                ? candidates.FirstOrDefault(m => m.Contains("qwen/qwen3.5", StringComparison.OrdinalIgnoreCase))
                : null;
            selected ??= candidates.FirstOrDefault(m => m.Contains("qwen/qwen3.5", StringComparison.OrdinalIgnoreCase))
                ?? candidates.FirstOrDefault(m => m.Contains("qwen3.5", StringComparison.OrdinalIgnoreCase))
                ?? candidates.FirstOrDefault(m => m.Contains("devstral", StringComparison.OrdinalIgnoreCase))
                ?? candidates.FirstOrDefault(m => m.Contains("mistral", StringComparison.OrdinalIgnoreCase))
                ?? candidates.FirstOrDefault(m => m.Contains("llama", StringComparison.OrdinalIgnoreCase))
                ?? candidates.FirstOrDefault(m => m.Contains("qwen", StringComparison.OrdinalIgnoreCase))
                ?? candidates.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(selected))
            {
                model = selected;
                return;
            }
        }
        catch
        {
            // Model discovery is best-effort; fall back to provider-kind defaults below.
        }

        model = provider.Kind switch
        {
            AiProviderKind.OpenAiCompatible => "qwen2.5-coder-7b-instruct",
            AiProviderKind.Ollama => "llama3.1",
            AiProviderKind.OpenAI => "gpt-4.1-mini",
            AiProviderKind.Gemini => "gemini-2.5-flash",
            _ => model
        };
    }

    private async Task LoadSettingsAsync()
    {
        if (settingsLoaded) return;
        settingsLoaded = true;
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", [SettingsKey]);
        if (string.IsNullOrWhiteSpace(json)) return;

        try
        {
            var saved = System.Text.Json.JsonSerializer.Deserialize<ExplanationPageSettings>(json);
            if (saved is null) return;
            if (!string.IsNullOrWhiteSpace(saved.ProviderId)) providerId = saved.ProviderId;
            if (!string.IsNullOrWhiteSpace(saved.Model)) model = saved.Model;
            if (!string.IsNullOrWhiteSpace(saved.PackId)) packId = saved.PackId;
            profile = saved.Profile;
            instruction = saved.Instruction;
            includeSourceSnippets = saved.IncludeSourceSnippets;
            includeTests = saved.IncludeTests;
            includeGeneratedDocs = saved.IncludeGeneratedDocs;
            includePublicApi = saved.IncludePublicApi;
            includeFlows = saved.IncludeFlows;
            includeArchitecture = saved.IncludeArchitecture;
            maxInputTokens = saved.MaxInputTokens;
            maxOutputTokens = saved.MaxOutputTokens;
        }
        catch
        {
            // Ignore stale browser-local settings; the current form defaults remain valid.
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (!settingsLoaded) return;
        var settings = new ExplanationPageSettings(providerId, model, packId, profile, instruction, includeSourceSnippets, includeTests, includeGeneratedDocs, includePublicApi, includeFlows, includeArchitecture, maxInputTokens, maxOutputTokens);
        var json = System.Text.Json.JsonSerializer.Serialize(settings);
        await JS.InvokeAsync<object>("localStorage.setItem", [SettingsKey, json]);
    }

    private async Task SaveAsync(bool force = false)
    {
        if (result is null) return;
        busy = true;
        try
        {
            editedMarkdown = explanationEditor is null ? editedMarkdown : await explanationEditor.GetValueAsync();
            if (string.IsNullOrWhiteSpace(editedMarkdown))
            {
                Toast.ShowError("There is no explanation markdown to save.");
                return;
            }

            saveResult = await Api.SaveAiExplanationAsync(ProjectId, result.Id, force, editedMarkdown);
            Toast.ShowSuccess(saveResult.Saved ? "AI explanation saved." : "AI explanation was not saved.");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private Task ForceSaveAsync() => SaveAsync(true);

    private async Task CopyAsync()
    {
        editedMarkdown = explanationEditor is null ? editedMarkdown : await explanationEditor.GetValueAsync();
        if (string.IsNullOrWhiteSpace(editedMarkdown)) return;
        await JS.InvokeAsync<object>("navigator.clipboard.writeText", [editedMarkdown]);
        Toast.ShowSuccess("Explanation copied.");
    }

    private sealed record ExplanationPageSettings(
        string? ProviderId,
        string Model,
        string PackId,
        ExplanationProfile Profile,
        string? Instruction,
        bool IncludeSourceSnippets,
        bool IncludeTests,
        bool IncludeGeneratedDocs,
        bool IncludePublicApi,
        bool IncludeFlows,
        bool IncludeArchitecture,
        int MaxInputTokens,
        int MaxOutputTokens);
}
