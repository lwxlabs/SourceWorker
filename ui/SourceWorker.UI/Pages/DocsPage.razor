@page "/projects/{ProjectId:guid}/docs"

@inject ISourceWorkerApiClient Api
@inject ToastService Toast
@inject DashboardActionService Actions

<ProjectWorkspaceLayout ProjectId="@ProjectId" Active="docs">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Backend Docs</h1>
        <p class="text-muted mb-0">Canonical docs come from <code>.ai-context/docs/backend</code>. The external <code>instructions/Result/Backend</code> mirror is only an export target.</p>
    </div>
    @{ var availability = Actions.GetAvailability(DashboardActionKind.ExportDocs); }
    <button class="btn btn-outline-primary" @onclick="ExportDocs" disabled="@(!availability.IsEnabled || exporting)" title="@availability.DisabledReason">
        @if (exporting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        }
        <i class="bi bi-box-arrow-up me-1"></i> Export to instructions/Result/Backend
    </button>
</div>

<BackendDocsViewer ProjectId="@ProjectId" />
</ProjectWorkspaceLayout>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private bool exporting;

    private async Task ExportDocs()
    {
        exporting = true;
        try
        {
            var result = await Api.RunExportAsync(ProjectId, "backend-docs-compact");
            Toast.ShowSuccess($"Exported {result.Files.Count} files to {result.OutputPath}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to export docs: {ex.Message}");
        }
        finally
        {
            exporting = false;
        }
    }
}
