<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceWorker.ApiClient\SourceWorker.ApiClient.csproj" />
    <ProjectReference Include="..\..\..\..\..\libs\LwXLab.AI.Engine\LwXLab.AI.Engine.csproj" Condition="'$(SourceWorkerPrivateExtensions)' == 'true'" />
    <ProjectReference Include="..\..\..\..\..\libs\LwXLab.Markdown\LwXLab.Markdown.csproj" Condition="'$(SourceWorkerPrivateExtensions)' == 'true'" />
    <ProjectReference Include="..\..\..\..\..\libs\LwXLab.FileEditor\LwXLab.FileEditor.csproj" Condition="'$(SourceWorkerPrivateExtensions)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(SourceWorkerPrivateExtensions)' != 'true'">
    <ProjectReference Include="$(SourceWorkerDependencyRoot)/LwXLab.Markdown/LwXLab.Markdown.csproj" />
    <RazorComponent Remove="Pages/AdvancedFilesPage.razor" />
    <Content Remove="Pages/AdvancedFilesPage.razor" />
    <Compile Remove="Services/ProjectFileEditorServices.cs" />
  </ItemGroup>
</Project>
