@inject ISourceWorkerApiClient Api

<div class="split">
    <nav class="doc-tabs">
        @foreach (var file in Files)
        {
            <a href="@($"/projects/{ProjectId}/docs?file={Uri.EscapeDataString(file)}")">@Path.GetFileName(file)</a>
        }
    </nav>
    @if (!string.IsNullOrWhiteSpace(error) && SelectedFileOrDefault.EndsWith("07-ai-explanation.md", StringComparison.OrdinalIgnoreCase))
    {
        <div class="empty-state">
            <h3>AI explanation not generated yet</h3>
            <p>Generate a durable AI explanation when you want a senior-developer style project walkthrough. SourceWorker will not edit source files.</p>
            <a class="btn btn-primary" href="/projects/@ProjectId/explanation">Generate AI explanation</a>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ErrorState Message="@error" />
    }
    else
    {
        <MarkdownViewer Content="@content" />
    }
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "file")] public string? SelectedFile { get; set; }

    private readonly string[] Files =
    [
        ".ai-context/docs/backend/README.md",
        ".ai-context/docs/backend/01-project-structure.md",
        ".ai-context/docs/backend/02-architecture.md",
        ".ai-context/docs/backend/03-important-files-and-flows.md",
        ".ai-context/docs/backend/04-configuration-and-secrets.md",
        ".ai-context/docs/backend/05-tasks-and-risks.md",
        ".ai-context/docs/backend/06-verification-checklist.md",
        ".ai-context/docs/backend/07-ai-explanation.md"
    ];
    private string? content;
    private string? error;
    private string SelectedFileOrDefault => string.IsNullOrWhiteSpace(SelectedFile) ? Files[0] : SelectedFile;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            content = await Api.ReadContextAsync(ProjectId, SelectedFileOrDefault);
            error = null;
        }
        catch (Exception ex)
        {
            content = null;
            error = ex.Message;
        }
    }
}
