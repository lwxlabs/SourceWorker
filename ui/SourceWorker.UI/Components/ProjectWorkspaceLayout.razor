@inject ISelectedProjectState SelectedProject

@if (context is null && loading)
{
    <LoadingState />
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <ErrorState Message="@error" />
}
else if (context is null)
{
    <EmptyState Message="Select a project first." />
    <a class="btn btn-primary" href="/projects">Open Projects</a>
}
else
{
    <section class="project-workspace">
        @if (!string.IsNullOrWhiteSpace(refreshError))
        {
            <div class="alert alert-warning" role="status">@refreshError</div>
        }

        <ProjectHeader Context="@context" OnRefreshRequested="RefreshWorkspaceHeaderAsync" />
        <ProjectTabs ProjectId="@ProjectId" Active="@Active" />
        <div class="project-workspace-body">
            @ChildContent
        </div>
    </section>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string Active { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ProjectWorkspaceContext? context;
    private bool loading = true;
    private string? error;
    private string? refreshError;
    private Guid? loadedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProjectId == ProjectId && context is not null)
        {
            return;
        }

        loadedProjectId = ProjectId;
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        loading = true;
        try
        {
            context = await SelectedProject.LoadAsync(ProjectId);
            error = null;
            refreshError = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshWorkspaceHeaderAsync()
    {
        try
        {
            context = await SelectedProject.LoadAsync(ProjectId);
            refreshError = null;
        }
        catch (Exception ex)
        {
            refreshError = ex.Message;
        }
    }
}
