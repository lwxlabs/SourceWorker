<aside class="sw-sidebar">
    <a class="sw-brand" href="/">SourceWorker</a>
    <nav>
        @foreach (var item in SourceWorkerNavigation.GlobalPrimary)
        {
            <a href="@item.Href">@item.Label</a>
        }
        @foreach (var item in SourceWorkerNavigation.GlobalSecondary)
        {
            <a href="@item.Href">@item.Label</a>
        }
        <details class="nav-section">
            <summary>Advanced</summary>
            @foreach (var item in SourceWorkerNavigation.AdvancedGlobal)
            {
                <a href="@item.Href">@item.Label</a>
            }
        </details>
    </nav>
</aside>
