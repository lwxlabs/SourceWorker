<div class="card border-info">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Cleanup Preview</h5>
        <span class="badge bg-light text-dark">@Preview.SafeToDeleteCount safe to delete</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>File</th>
                        <th>Kind</th>
                        <th>Safe?</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var candidate in Preview.Candidates.OrderByDescending(c => c.SafeToDelete).ThenBy(c => c.RelativePath))
                    {
                        <tr>
                            <td><code>@candidate.RelativePath</code></td>
                            <td><small>@candidate.Kind</small></td>
                            <td>
                                @if (candidate.SafeToDelete)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> Yes</span>
                                }
                                else
                                {
                                    <span class="text-warning"><i class="bi bi-exclamation-circle-fill"></i> No</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Preview.RecommendedCommand))
    {
        <div class="card-footer small text-muted">
            Recommended CLI: <code>@Preview.RecommendedCommand</code>
        </div>
    }
</div>

@code {
    [Parameter] public CleanupPreviewDto Preview { get; set; } = null!;
}
