@if (IsVisible)
{
    <div class="card mb-4 @GetBorderClass()">
        <div class="card-header @GetHeaderClass()">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Title</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Message))
            {
                <p>@Message</p>
            }

            @if (ChildContent != null)
            {
                @ChildContent
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Result";
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsSuccess { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private string GetBorderClass() => IsSuccess ? "border-success" : "border-danger";
    private string GetHeaderClass() => IsSuccess ? "bg-success text-white" : "bg-danger text-white";
}
