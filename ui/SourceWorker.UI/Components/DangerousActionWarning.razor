<div class="alert alert-danger d-flex align-items-center" role="alert">
    <div class="me-3">
        <i class="bi bi-exclamation-triangle-fill fs-2"></i>
    </div>
    <div>
        <h4 class="alert-heading">Dangerous Action!</h4>
        <p class="mb-0">@Message</p>
    </div>
</div>

@code {
    [Parameter] public string Message { get; set; } = "This action is destructive and cannot be undone.";
}
