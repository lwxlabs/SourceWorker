@inject ISourceWorkerApiClient Api

<header class="sw-topbar">
    <div>
        <strong>SourceWorker</strong>
        <span class="muted">@Options.LaunchMode</span>
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        @if (status != null)
        {
            <span class="pill @(status.Connected ? "ok" : "warn")">
                @(status.Connected ? "API OK" : "API Offline")
            </span>
            @if (status.Connected && status.Runtime != null)
            {
                <span style="font-size: 0.75rem; background: #eef; color: #336; border: 1px solid #ccd; padding: 2px 6px; border-radius: 4px;">
                    @(status.Runtime.TokenEnabled ? "🔒 Auth" : "🔓 Open")
                </span>
            }
        }
    </div>
</header>

@code {
    [Inject] private SourceWorkerApiClientOptions Options { get; set; } = default!;
    private ApiConnectionStatus? status;

    protected override async Task OnInitializedAsync()
    {
        status = await Api.CheckConnectionAsync();
    }
}
