@if (Projects.Count == 0)
{
    <EmptyState Message="No projects matched your filters." />
}
else
{
    <div class="project-list">
        @foreach (var project in Projects)
        {
            <div class="project-row project-row-manage">
                <a class="project-row-main" href="/projects/@project.Id">
                    <strong>@project.Name</strong>
                    <span class="path">@project.Path</span>
                </a>
                <div class="project-row-meta">
                    @if (project.LastScanUtc.HasValue)
                    {
                        <span title="Last scan">@project.LastScanUtc.Value.ToString("g")</span>
                    }
                    <span title="Routes">Routes @project.RouteCount</span>
                    <span title="Flows">Flows @project.FlowCount</span>
                    @if (project.HasStaleContext)
                    {
                        <span class="pill warn">Stale</span>
                    }
                    @if (!project.Exists)
                    {
                        <span class="pill warn">Missing</span>
                    }
                    <a class="btn btn-outline-secondary btn-sm" href="/projects/@project.Id">Open</a>
                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => Scan(project)" disabled="@scanning.Contains(project.Id)">@(project.LastScanUtc.HasValue ? "Rescan" : "Scan")</button>
                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => CopyHandoff(project)">Copy Handoff</button>
                    @if (OnRemove.HasDelegate)
                    {
                        <button class="btn btn-outline-danger btn-sm" type="button" @onclick="() => OnRemove.InvokeAsync(project)">Remove</button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<ProjectSummaryDto> Projects { get; set; } = [];
    [Parameter] public EventCallback<ProjectSummaryDto> OnRemove { get; set; }

    private readonly HashSet<Guid> scanning = [];

    private async Task Scan(ProjectSummaryDto project)
    {
        scanning.Add(project.Id);
        try
        {
            await Api.StartProjectScanAsync(project.Id);
            Toast.ShowInfo($"Scan started for {project.Name}.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to start scan: {ex.Message}");
        }
        finally
        {
            scanning.Remove(project.Id);
        }
    }

    private async Task CopyHandoff(ProjectSummaryDto project)
    {
        try
        {
            var handoff = await Api.GetAgentHandoffAsync(project.Id);
            await JS.InvokeAsync<object>("navigator.clipboard.writeText", [handoff.Markdown]);
            Toast.ShowSuccess("Handoff copied.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to copy handoff: {ex.Message}");
        }
    }
}
@inject ISourceWorkerApiClient Api
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ToastService Toast
