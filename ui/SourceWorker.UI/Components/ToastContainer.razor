@inject ToastService ToastService
@implements IDisposable

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    @foreach (var message in ToastService.Messages)
    {
        <div class="toast show mb-2 @GetToastClass(message.Level)" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">@message.Level</strong>
                <small>@message.Timestamp.ToLocalTime().ToString("t")</small>
                <button type="button" class="btn-close" @onclick="() => ToastService.Remove(message.Id)" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @message.Message
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += HandleToastChanged;
    }

    private void HandleToastChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetToastClass(ToastLevel level) => level switch
    {
        ToastLevel.Success => "border-success",
        ToastLevel.Error => "border-danger",
        ToastLevel.Warning => "border-warning",
        _ => "border-info"
    };

    public void Dispose()
    {
        ToastService.OnChange -= HandleToastChanged;
    }
}
